import numpy as np
import matplotlib.pyplot as plt

N = 1000
def recorrido(N):
    x_i = np.random.choice([-1, 1], size=N, p=[0.5, 0.5])
    return np.cumsum(x_i)



plt.plot(recorrido(N))
plt.xlabel("Numero de pasos")
plt.ylabel("Posición (m)")
plt.legend(['Recorrido de un borracho'])
plt.show()

#Mi razonamiento aqui es el siguente: Considero un N grande como para ser procesable, asi como los eventos (x_i) como variables 
# independientes. Ahora bien, lo que quiero determinar es la distancia a la que estaria despues de N pasos. Considerando que 
# dar la probabilidad de dar un paso hacia la izquerda y hacia la derecha es la misma, entonces le asocio probabilidad en la 
# variable x_i. Luego lo que yo quiero es ver el valor final al que alcanza la posicion para poder determinar la distancia tipica.
# 
# Sin embargo, me cabe la duda de si es correcto hacerlo para un unico caso, el "tipico" me puede dar a entender que lo generalice 
# a varios escenarios. Es por ello que se puede adaptar el codigo para que se analice la dispersion de varios escenarios y asi obtener 
# un valor distinto de la distancia tipica.


n_escenarios = 2000
P_finales = np.array([recorrido(N)[-1] for i in range(n_escenarios)])
distancia_tipica = np.std(P_finales)
promedio = np.mean(P_finales)
print("Distancia típica:", distancia_tipica)
print("Promedio:", promedio)

plt.hist(P_finales)
plt.xlabel("posicion (m)")
plt.ylabel("frecuencia de los escenarios")
plt.axvline(x=promedio, color='black', linestyle='--', label='promedio posición final')
plt.legend()
plt.show()